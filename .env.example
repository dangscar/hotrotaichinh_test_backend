# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tthc_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
JWT_SESSION_REFRESH_EXPIRES_IN=8h

# CORS
CLIENT_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email — Gmail (bắt buộc để gửi link quên mật khẩu)
# 1. Bật xác minh 2 bước: https://myaccount.google.com/security
# 2. Tạo App Password: https://myaccount.google.com/apppasswords
# 3. Chọn "Mail" + "Windows Computer" → copy mật khẩu 16 ký tự (bỏ dấu cách khi dán)
# 4. EMAIL_FROM phải trùng SMTP_USER khi dùng Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# Digital Signature (CA Provider)
CA_API_URL=
CA_API_KEY=

# Logging
LOG_DIR=./logs
LOG_LEVEL=info
